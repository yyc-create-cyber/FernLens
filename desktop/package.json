{
  "name": "fernlens-desktop",
  "productName": "FernLens",
  "version": "1.0.0",
  "description": "FernLens — 本地照片调色器（Electron 壳）",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:x64": "electron-builder --mac --x64"
  },
  "author": "nothing1145141",
  "license": "SEE LICENSE IN ../LICENSE",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fernlens.app",
    "productName": "FernLens",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "afterpack.cjs", "package.json"],
    "afterPack": "afterpack.cjs",
    "extraResources": [
      { "from": "../backend-dist/fernlens-server", "to": "backend" }
    ],
    "win": {
      "icon": "../build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "mac": {
      "icon": "../build/icon.png",
      "category": "public.app-category.photography",
      "target": ["dmg", "zip"],
      "artifactName": "FernLens-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "NSRequiresAquaSystemAppearance": false
      }
    },
    "dmg": {
      "title": "FernLens ${version}",
      "artifactName": "FernLens-Setup-${version}-${arch}.${ext}",
      "contents": [
        { "x": 130, "y": 220, "type": "file" },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FernLens-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FernLens-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "nothing1145141",
      "repo": "fernlens"
    }
  }
}
